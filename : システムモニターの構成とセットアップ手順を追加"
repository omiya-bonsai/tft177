[32m+[m[32m## Display Flicker[m
[32m+[m
[32m+[m[32m### バックライトPWMを使用しない[m
[32m+[m
[32m+[m[32mこの環境では、GPIO13のバックライトを `PWMOutputDevice` で駆動すると、[m
[32m+[m[32mTFT表示に強いチラつきが発生しました。[m
[32m+[m
[32m+[m[32m問題が発生した構成：[m
[32m+[m
[32m+[m[32m```python[m
[32m+[m[32mfrom gpiozero import PWMOutputDevice[m
[32m+[m
[32m+[m[32mbacklight = PWMOutputDevice([m
[32m+[m[32m    BACKLIGHT_PIN,[m
[32m+[m[32m    frequency=1000,[m
[32m+[m[32m    initial_value=0.45[m
[32m+[m[32m)[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m実機では、雷のような強い明滅が発生しました。[m
[32m+[m
[32m+[m[32mバックライトを通常のデジタル出力へ戻すことで解消しています。[m
[32m+[m
[32m+[m[32m```python[m
[32m+[m[32mfrom gpiozero import DigitalOutputDevice[m
[32m+[m
[32m+[m[32mbacklight = DigitalOutputDevice([m
[32m+[m[32m    BACKLIGHT_PIN,[m
[32m+[m[32m    initial_value=False[m
[32m+[m[32m)[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mON/OFF：[m
[32m+[m
[32m+[m[32m```python[m
[32m+[m[32mdef set_backlight(state):[m
[32m+[m[32m    if state:[m
[32m+[m[32m        backlight.on()[m
[32m+[m[32m    else:[m
[32m+[m[32m        backlight.off()[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m現在はGPIO13を常時HIGHとして使用しています。[m
[32m+[m
[32m+[m[32m**この環境ではバックライトのソフトウェアPWMは使用しないでください。**[m
[32m+[m
[32m+[m[32m---[m
