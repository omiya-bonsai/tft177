[32m+[m[32m# tft177 - Raspberry Pi System Monitor[m
[32m+[m
[32m+[m[32mRaspberry Pi用「TFT 1.77インチ + スイッチ2個 + LED 2個」の汎用UI基板を使用した、[m
[32m+[m[32m小型システムモニターです。[m
[32m+[m
[32m+[m[32mこのリポジトリは [momorara/tft177](https://github.com/momorara/tft177) をforkし、[m
[32m+[m[32mRaspberry Piの常時表示システムモニターとして機能を追加したものです。[m
[32m+[m
[32m+[m[32m- Upstream: [momorara/tft177](https://github.com/momorara/tft177)[m
[32m+[m[32m- Fork: [omiya-bonsai/tft177](https://github.com/omiya-bonsai/tft177)[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m## System Monitor[m
[32m+[m
[32m+[m[32m`pi_monitor.py` でRaspberry Piの状態を1.77インチTFTへ常時表示します。[m
[32m+[m
[32m+[m[32m表示項目：[m
[32m+[m
[32m+[m[32m- CPU使用率[m
[32m+[m[32m- CPU温度[m
[32m+[m[32m- メモリ使用率[m
[32m+[m[32m- Uptime[m
[32m+[m
[32m+[m[32m160 x 128 pxの小型ディスプレイで視認しやすいよう、[m
[32m+[m[32m情報量を抑えた2カラムUIにしています。[m
[32m+[m
[32m+[m[32m```text[m
[32m+[m[32mrpi1[m
[32m+[m
[32m+[m[32m  12%          43.2°[m
[32m+[m[32m  CPU          TEMP[m
[32m+[m
[32m+[m[32m  31%[m
[32m+[m[32m  MEMORY[m
[32m+[m
[32m+[m[32mUp 2d 04h[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m数値には `DejaVu Sans ExtraLight`、ラベルには通常の `DejaVu Sans` を使用しています。[m
[32m+[m
[32m+[m[32m通常時はモノトーン表示とし、CPU負荷・CPU温度・メモリ使用率が閾値を超えた場合のみ赤色で表示します。[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m## Controls[m
[32m+[m
[32m+[m[32m### SW2 - Safe Shutdown[m
[32m+[m
[32m+[m[32mSW2を約2秒間長押しすると、Raspberry Piを安全にシャットダウンします。[m
[32m+[m
[32m+[m[32mシャットダウン開始時にはTFTへ[m
[32m+[m
[32m+[m[32m```text[m
[32m+[m[32mShutting Down[m
[32m+[m
[32m+[m[32mplease wait[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mと表示し、LED2が点滅します。[m
[32m+[m
[32m+[m[32mGPIO：[m
[32m+[m
[32m+[m[32m| Device | GPIO | Function |[m
[32m+[m[32m|---|---:|---|[m
[32m+[m[32m| SW1 | GPIO5 | Reserved |[m
[32m+[m[32m| SW2 | GPIO6 | Shutdown button |[m
[32m+[m[32m| LED1 | GPIO17 | Reserved |[m
[32m+[m[32m| LED2 | GPIO27 | Shutdown indicator |[m
[32m+[m[32m| TFT RESET | GPIO18 | Display reset |[m
[32m+[m[32m| TFT Backlight | GPIO13 | Backlight |[m
[32m+[m[32m| TFT DC | GPIO0 | Data / Command |[m
[32m+[m
[32m+[m[32mSW1 / SW2は `gpiozero.Button` の内部プルダウンを使用します。[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m## Hardware[m
[32m+[m
[32m+[m[32m使用基板：[m
[32m+[m
[32m+[m[32m**ラズベリーパイ用 汎用UI基板（TFT 1.77インチ）**[m
[32m+[m
[32m+[m[32mTFT：[m
[32m+[m
[32m+[m[32m- 1.77 inch[m
[32m+[m[32m- 160 x 128 px[m
[32m+[m[32m- RGB[m
[32m+[m[32m- SPI[m
